@charset "utf-8";

.root_f8e2bfcb { position: absolute; inset: 0px; overflow: clip; user-select: none; }

.root_f8e2bfcb:focus { outline: 0px; }

.platform_f8e2bfcb { z-index: 0; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; transform-origin: 0px 0px; touch-action: none; }

.platform_f8e2bfcb.enabled_f8e2bfcb { will-change: transform; backface-visibility: hidden; }

.slide_f8e2bfcb { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 1; opacity: 0; visibility: hidden; transition: opacity linear 0.3s, visibility linear 0.3s, transform linear; }

.slide_f8e2bfcb.current_f8e2bfcb.loaded_f8e2bfcb { opacity: 1; visibility: inherit; transition-delay: 0s, 0s, 0s; }

.slide_f8e2bfcb.current_f8e2bfcb.deleted_f8e2bfcb, .slide_f8e2bfcb.deleted_f8e2bfcb { z-index: 0; opacity: 0; visibility: hidden; transition-duration: 0s, 0s, 0s; transition-delay: 0s, 0s, 0s; }

.platform_f8e2bfcb.enabled_f8e2bfcb .slide_f8e2bfcb { will-change: transform; backface-visibility: hidden; }

.platform_f8e2bfcb.flipping_f8e2bfcb .slide_f8e2bfcb { transition-duration: 0s, 0s, 0s; transition-delay: 0s, 0s, 0s; }

